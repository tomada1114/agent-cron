        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open AgentCron…"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AgentCron を開く…"
          }
        }
      }
    },
