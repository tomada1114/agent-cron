      "comment" : "Title of the main window. The app's name.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AgentCron"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AgentCron"
          }
        }
      }
    },
    "frontmostApp.label" : {
