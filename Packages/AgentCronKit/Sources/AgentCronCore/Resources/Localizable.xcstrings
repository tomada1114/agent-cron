        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld分%lld秒"
          }
        }
      }
    },
    "history.duration.seconds" : {
      "comment" : "A run's duration under a minute. The argument is seconds.",
