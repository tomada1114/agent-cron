      "comment" : "Error under the job editor's Timeout field when it is outside 1 to 1,440 minutes.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enter a timeout from 1 to 1,440 minutes."
          }
