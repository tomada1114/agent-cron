{
  "sourceLanguage" : "en",
  "strings" : {
    "appWindow.main.open" : {
      "comment" : "Button in the menu-bar popover that opens the main window.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open AgentCron…"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AgentCron を開く…"
          }
        }
      }
    },
    "appWindow.main.placeholder" : {
      "comment" : "Placeholder text in the main window before its screens exist.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jobs, history, and settings will appear here."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ジョブ、履歴、設定がここに表示されます。"
          }
        }
      }
    },
    "appWindow.main.title" : {
      "comment" : "Title of the main window. The app's name.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AgentCron"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AgentCron"
          }
        }
      }
    },
    "frontmostApp.label" : {
      "comment" : "Footnote naming the application that is frontmost. The argument is that application's name.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frontmost: %@"
          }
        }
      }
    },
    "frontmostApp.unavailable" : {
      "comment" : "Footnote shown when no application is frontmost, or before the app has asked.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frontmost: —"
          }
        }
      }
    },
    "jobValidation.directoryNotLocal" : {
      "comment" : "Error under the job editor's Directory field when the directory is not a folder on this Mac.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose a folder on this Mac."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このMac上のフォルダを選択してください。"
          }
        }
      }
    },
    "jobValidation.duplicateTimes" : {
      "comment" : "Error under the job editor's Times row when the same time is listed more than once.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remove the duplicate time."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重複している時刻を削除してください。"
          }
        }
      }
    },
    "jobValidation.nameEmpty" : {
      "comment" : "Error under the job editor's Name field when it is empty.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enter a name."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "名前を入力してください。"
          }
        }
      }
    },
    "jobValidation.nameTooLong" : {
      "comment" : "Error under the job editor's Name field when it is longer than 60 characters.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shorten the name to 60 characters or fewer."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "名前は60文字以内にしてください。"
          }
        }
      }
    },
    "jobValidation.noTimes" : {
      "comment" : "Error under the job editor's Times row when the schedule has no time.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add at least one time."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "時刻を1つ以上追加してください。"
          }
        }
      }
    },
    "jobValidation.noWeekdays" : {
      "comment" : "Error under the job editor's Days chips when no day of the week is selected.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose at least one day."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "曜日を1つ以上選択してください。"
          }
        }
      }
    },
    "jobValidation.promptEmpty" : {
      "comment" : "Error under the job editor's Prompt field when it is empty or only whitespace.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enter a prompt."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プロンプトを入力してください。"
          }
        }
      }
    },
    "jobValidation.timeoutOutOfRange" : {
      "comment" : "Error under the job editor's Timeout field when it is outside 1 to 1,440 minutes.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enter a timeout from 1 to 1,440 minutes."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タイムアウトは1〜1,440分の範囲で入力してください。"
          }
        }
      }
    },
    "menuBarPopover.placeholder" : {
      "comment" : "Placeholder text in the menu-bar popover before the run timeline exists.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scheduled runs will appear here."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "予定された実行がここに表示されます。"
          }
        }
      }
    },
