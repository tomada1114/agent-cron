    "jobDelete.message" : {
      "comment" : "Message of the alert that confirms deleting a job that is not running.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Its past runs stay in History for up to 90 days."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "過去の実行は最大90日間、履歴に残ります。"
          }
        }
      }
    },
    "jobDelete.messageRunning" : {
      "comment" : "Message of the alert that confirms deleting a job while it is running.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Its past runs stay in History for up to 90 days. The running job will be stopped."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "過去の実行は最大90日間、履歴に残ります。実行中のジョブは停止されます。"
          }
        }
      }
    },
    "jobDelete.title" : {
      "comment" : "Title of the alert that confirms deleting a job. The argument is the job's name.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delete “%@”?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」を削除しますか？"
          }
        }
      }
    },
    "jobEditor.runningNote" : {
      "comment" : "Note under the job editor's header while the job is running.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Changes apply from the next run."
